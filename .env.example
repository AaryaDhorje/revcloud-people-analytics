# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. On Vercel, set these as
# Environment Variables in the project settings instead.
# ---------------------------------------------------------------------------

# Postgres. Must use the postgresql+asyncpg:// scheme (SQLAlchemy async driver).
# Local (docker compose up -d):
DATABASE_URL=postgresql+asyncpg://revcloud:revcloud@localhost:5434/revcloud
# Production example — append ?ssl=require for most managed providers:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# Signing key for JWTs. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Client is force-logged-out after this much inactivity.
IDLE_TIMEOUT_MINUTES=30

# Bootstrap admin, created by `python -m scripts.bootstrap_db`.
SEED_ADMIN_EMAIL=admin@revcloud.io
SEED_ADMIN_PASSWORD=Admin123!

# "console" writes reset links to the server log (fine for the MVP).
# "smtp" additionally requires the SMTP_* vars below.
PASSWORD_RESET_DELIVERY=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@revcloud.io

# Set to the deployment origin in production, e.g. https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# Cookies are only marked Secure when this is "production".
ENVIRONMENT=development
